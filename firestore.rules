rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'test@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Validation Blueprints
    function isValidApplication(data) {
      return data.keys().hasAll(['userId']) &&
             (data.userId == request.auth.uid || isAdmin()) &&
             (data.get('firstNameEn', '') is string) &&
             (data.get('lastNameEn', '') is string) &&
             (data.get('currentStep', 0) is number);
    }

    match /applications/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidApplication(incoming()) && isValidId(userId);
      allow update: if isOwner(userId) && isValidApplication(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstNameNp', 'firstNameEn', 'middleNameNp', 'middleNameEn', 'lastNameNp', 'lastNameEn',
          'dobNp', 'dobEn', 'birthPlace', 'ccType', 'citizenshipNo', 'district', 'issuedDate',
          'gender', 'maritalStatus', 'fatherStatus', 'education', 'profession', 'business',
          'caste', 'religion', 'nidNo', 'permPhone', 'permMobile', 'permState', 'permDistrict',
          'permLocalLevel', 'permWard', 'permVillage', 'tempPhone', 'tempMobile', 'tempState',
          'tempDistrict', 'tempLocalLevel', 'tempWard', 'tempVillage', 'fatherFirstNameNp',
          'fatherFirstNameEn', 'fatherLastNameNp', 'fatherLastNameEn', 'fatherCitizenshipNo',
          'fatherNidNo', 'fatherNationality', 'fatherPermState', 'fatherPermDistrict',
          'fatherPermLocalLevel', 'fatherPermWard', 'fatherTempState', 'fatherTempDistrict',
          'fatherTempLocalLevel', 'fatherTempWard', 'motherFirstNameNp', 'motherFirstNameEn',
          'motherLastNameNp', 'motherLastNameEn', 'motherNationality', 'motherPermState', 'motherPermDistrict',
          'motherPermLocalLevel', 'motherPermWard', 'motherTempState', 'motherTempDistrict',
          'motherTempLocalLevel', 'motherTempWard', 'grandFatherFirstNameNp', 'grandFatherFirstNameEn',
          'grandFatherLastNameNp', 'grandFatherLastNameEn', 'grandFatherNationality', 'grandFatherPermState', 
          'grandFatherPermDistrict', 'grandFatherPermLocalLevel', 'grandFatherPermWard', 'grandFatherTempState', 
          'grandFatherTempDistrict', 'grandFatherTempLocalLevel', 'grandFatherTempWard', 'currentStep', 'updatedAt',
          'copyToTemp', 'fatherMirrorAddress', 'motherMirrorAddress', 'grandFatherMirrorAddress'
        ])
      );
      allow delete: if false; // Applications should probably not be deleted by users easily
    }
  }
}
